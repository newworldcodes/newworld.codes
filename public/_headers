# Response headers for Cloudflare Workers static assets. The static export
# copies this file to out/_headers, where the asset server picks it up.
#
# The Content-Security-Policy allows 'unsafe-inline' scripts because the
# static export inlines Next.js's page data and the theme script, and there's
# no server to add a per-request nonce. The site loads no third-party hosts.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build output never changes, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/plain; charset=utf-8

# Apple fetches this without a file extension and expects JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Generated images are exported without a file extension.
/opengraph-image
  Content-Type: image/png
/*/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
